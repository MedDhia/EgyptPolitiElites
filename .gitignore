# Source scans are CEAlex's to distribute; keep digests, not content.
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json
data/interim/*
!data/interim/.gitkeep
# The built dataset is the deliverable, so the tables and the Gephi files are
# tracked. GraphML and the pooled graphs are omitted: they duplicate the GEXF
# and regenerate with `politi build --roster`.
data/processed/*
!data/processed/.gitkeep
!data/processed/*.csv
!data/processed/graphs/
data/processed/graphs/*
!data/processed/graphs/*.gexf
data/processed/graphs/*_pooled.gexf

# data/incoming/ is NOT ignored: it is the drop point for volumes delivered
# through git when the pipeline host cannot reach the source directly.
!data/incoming/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/

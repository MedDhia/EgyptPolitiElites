# Source scans are CEAlex's to distribute; keep digests, not content.
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# data/incoming/ is NOT ignored: it is the drop point for volumes delivered
# through git when the pipeline host cannot reach the source directly.
!data/incoming/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
